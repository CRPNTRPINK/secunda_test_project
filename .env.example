# --- инфраструктура (используется docker-compose) ---
POSTGRES_USER=payments
POSTGRES_PASSWORD=payments
POSTGRES_DB=payments
# порты на хосте намеренно нестандартные, чтобы не конфликтовать
# с локально установленными Postgres и RabbitMQ
POSTGRES_PORT=55432

RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest
RABBITMQ_PORT=55672
RABBITMQ_UI_PORT=15673

API_PORT=8000

# --- приложение ---
API_KEY=local-dev-api-key
LOG_LEVEL=INFO

# Для локального запуска без Docker раскомментируйте:
# DATABASE_URL=postgresql+asyncpg://payments:payments@localhost:55432/payments
# RABBITMQ_URL=amqp://guest:guest@localhost:55672/

# --- эмуляция платежного шлюза ---
PROCESSING_MIN_SECONDS=2
PROCESSING_MAX_SECONDS=5
PROCESSING_SUCCESS_RATE=0.9

# --- consumer ---
CONSUMER_PREFETCH_COUNT=10

# --- retry / DLQ ---
MAX_DELIVERY_ATTEMPTS=3
RETRY_BASE_DELAY_SECONDS=2
RETRY_MAX_DELAY_SECONDS=60
WEBHOOK_TIMEOUT_SECONDS=10

# --- outbox relay ---
OUTBOX_POLL_INTERVAL_SECONDS=1
OUTBOX_BATCH_SIZE=50
OUTBOX_MAX_ATTEMPTS=10
